# Free Gemini for original scripts and trend analysis. Optional for built-in fallback demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional official YouTube Data API key (for public Indian trend discovery).
YOUTUBE_API_KEY=

# motion: fully automatic template animation with optional speech
# flow_manual: use two clips saved in flow_inputs/slot1/ (and slot2/)
VIDEO_BACKEND=motion
VIDEO_SLOT=auto
AUTO_PUBLISH=true
YOUTUBE_PRIVACY=private

# YouTube OAuth credentials; enable YouTube Data API v3 and youtube.upload scope.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram Professional (Creator/Business) publishing via Meta Graph API
IG_USER_ID=
IG_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0
# Public video URL needed for Instagram; Cloudinary is one example.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Speech: auto (Edge TTS, then eSpeak), none, edge, espeak
TTS_BACKEND=auto
