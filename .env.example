# Gemini API for original scripts and cloud video generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
# Cloud video target: 20 (2 calls) or 30 (3 calls) seconds. Paid API; see README cost note.
GEMINI_VIDEO_TARGET_SECONDS=20

# Optional official YouTube Data API key for public Indian trend discovery.
YOUTUBE_API_KEY=
TRENDS_REGION=IN

# gemini_video: fully cloud-generated 20/30-second video via Gemini Omni API (paid)
# motion: fully automatic original motion-graphics Short (no video-generation charge)
# yt_create_manual: join three user-exported YouTube Create clips
# flow_manual: join user-exported Flow clips
VIDEO_BACKEND=motion
VIDEO_SLOT=auto

# Local runs default to preview-only. Scheduled GitHub jobs publish privately.
AUTO_PUBLISH=false
YOUTUBE_PRIVACY=private
# Turn true when publishing realistic AI-generated or altered scenes/people.
YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=false

# YouTube OAuth; enable YouTube Data API v3 and youtube.upload scope.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional Instagram Professional (Creator/Business) publishing via Meta Graph API.
ENABLE_INSTAGRAM_PUBLISH=false
IG_USER_ID=
IG_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Speech: auto (Edge TTS, then eSpeak), none, edge, espeak.
TTS_BACKEND=auto
